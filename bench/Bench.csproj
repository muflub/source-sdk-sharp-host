<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Deliberately NOT importing the repo's Directory.Build.props/targets: those
    central-pin package versions, and ZstdSharp.Port is a measurement dependency
    only — it must never become one the shipped product depends on. The probe is
    excluded from Host.slnx; `make bench` runs it explicitly.

    What this harness is: the §3.1 measurement table of
    docs/plans/plan_build_patch.md, reproducible. It generates the fixture
    (fixtures/gen.A.cs → three variants), compiles them, splits each dll into its
    PE metadata streams and PE sections, and reports per-stream byte divergence
    and zstd-19 rawdict delta sizes. It asserts the numbers that carry a ruling
    (a check that cannot fail is not evidence); exit ≠ 0 means the plan's
    measured basis moved and the ruling must be revisited.

    Never add DllImport here (repo rule R-managed): ZstdSharp.Port is pure
    managed, which is exactly why the plan's delta primitive is this codec.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>

