# syntax=docker/dockerfile:1
# Descent.Service, published on the ASP.NET runtime image. Build with
#   podman build -f deploy/Dockerfile.service --build-context maptools=$(MapToolsRoot) .
# (make image-service). No game files, no ssmap executable: the map tools are an assembly.
FROM mcr.microsoft.com/dotnet/sdk:10.0.401 AS build
# Never name a build arg VERSION: RUN sees it as an environment variable, MSBuild
# reads that as $(Version), and a git sha there makes NuGet restore fail without
# logging an error ("RestoreTask returned false but did not log an error").
ARG BUILD_VERSION=0.0.0-dev
ENV HOME=/root DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
WORKDIR /src
# Only the map tools' sources: their host-built obj/ folders carry host paths.
COPY --from=maptools src /maptools/src
RUN find /maptools -type d \( -name obj -o -name bin \) -prune -exec rm -rf {} +
COPY . .
# global.json pins the host SDK (10.0.112), for which no image is published; the
# image's SDK is newer and builds the same net10.0 output.
RUN rm -f global.json \
 && printf '<Project><PropertyGroup><MapToolsRoot>/maptools/</MapToolsRoot></PropertyGroup></Project>\n' > roots.props \
 && dotnet publish src/Descent.Service/Descent.Service.csproj -c Release -o /out --nologo \
      -p:InformationalVersion=$BUILD_VERSION -p:UseAppHost=false
FROM mcr.microsoft.com/dotnet/aspnet:10.0.12
ARG BUILD_VERSION=0.0.0-dev
LABEL org.opencontainers.image.version=$BUILD_VERSION
WORKDIR /app
COPY --from=build /out /app
ENV DOTNET_gcServer=0
ENTRYPOINT ["dotnet", "/app/Descent.Service.dll"]
