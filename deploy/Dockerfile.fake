# syntax=docker/dockerfile:1
# Host.FakeGame (plan §7.6), the engine image of TIER=fake, on the ASP.NET runtime image. Build with
#   podman build -f deploy/Dockerfile.fake --build-arg BUILD_VERSION=$(git rev-parse --short HEAD) .
# (make image-fake). Its closure (Host.Sdk, Host.Relay, Host.FakeClient, Host.FakeRules) does not
# reference the map tools, so no maptools build context is needed.
FROM mcr.microsoft.com/dotnet/sdk:10.0.401 AS build
# Never name a build arg VERSION: RUN sees it as an environment variable, MSBuild
# reads that as $(Version), and a git sha there makes NuGet restore fail without
# logging an error ("RestoreTask returned false but did not log an error").
ARG BUILD_VERSION=0.0.0-dev
ENV HOME=/root DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
WORKDIR /src
COPY . .
# global.json pins the host SDK (10.0.112), for which no image is published; the
# image's SDK is newer and builds the same net10.0 output. roots.props must exist
# (Directory.Build.targets); nothing in this closure reads $(MapToolsRoot).
RUN rm -f global.json \
 && printf '<Project><PropertyGroup><MapToolsRoot>/nonexistent/</MapToolsRoot></PropertyGroup></Project>\n' > roots.props \
 && dotnet publish src/Host.FakeGame/Host.FakeGame.csproj -c Release -o /out --nologo \
      -p:InformationalVersion=$BUILD_VERSION -p:UseAppHost=false
FROM mcr.microsoft.com/dotnet/aspnet:10.0.12
ARG BUILD_VERSION=0.0.0-dev
LABEL org.opencontainers.image.version=$BUILD_VERSION
WORKDIR /app
# The level init container runs this image too (fetch-level.sh needs curl).
RUN apt-get update && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
COPY deploy/fetch-level.sh /opt/descent/fetch-level.sh
# The pod's command is the engine image's entrypoint path; here it starts the fake.
COPY deploy/fake-entrypoint.sh /opt/descent/game-entrypoint.sh
RUN chmod +x /opt/descent/fetch-level.sh /opt/descent/game-entrypoint.sh
COPY --from=build /out /app
ENV DOTNET_gcServer=0
ENTRYPOINT ["/opt/descent/game-entrypoint.sh"]
