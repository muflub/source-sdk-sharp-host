@* The admin document (plan §11): plain and dense, every page interactive over the circuit. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>Descent admin</title>
    <style>
        body { font: 13px/1.35 system-ui, sans-serif; margin: 0; display: flex; color: #111; background: #fff; }
        nav.side { width: 150px; min-height: 100vh; background: #f2f2f2; border-right: 1px solid #ccc; padding: 6px 0; flex: none; }
        nav.side a { display: block; padding: 3px 10px; color: #124; text-decoration: none; }
        nav.side a.active { background: #dde; font-weight: 600; }
        main { flex: 1; padding: 8px 14px; min-width: 0; }
        h1 { font-size: 17px; margin: 2px 0 8px; } h2 { font-size: 14px; margin: 12px 0 4px; }
        table { border-collapse: collapse; margin: 4px 0; } td, th { border: 1px solid #ccc; padding: 2px 5px; text-align: left; vertical-align: top; }
        th { background: #f4f4f4; } tr.sel td { background: #eef; }
        input, select, textarea, button { font: inherit; } textarea { width: 100%; min-height: 160px; font-family: monospace; }
        .bar { margin: 4px 0; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
        .ok { background: #e6f4e6; border: 1px solid #9c9; padding: 4px 8px; }
        .refused { background: #fbe9e9; border: 1px solid #d99; padding: 4px 8px; }
        .leased { background: #fff4d6; border: 1px solid #d9b95a; padding: 4px 8px; }
        .note { color: #666; } pre { background: #f8f8f8; border: 1px solid #ddd; padding: 4px; max-height: 360px; overflow: auto; margin: 2px 0; }
        .dialog { position: fixed; inset: 10% 20%; background: #fff; border: 2px solid #446; padding: 10px; overflow: auto; box-shadow: 0 0 0 100vmax rgba(0,0,0,.3); }
        .diff .del { background: #fdd; } .diff .add { background: #dfd; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
